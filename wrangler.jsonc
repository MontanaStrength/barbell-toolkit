{
  // Cloudflare Worker that serves the static build. No server code: every
  // request is a file from ./dist, and paths with no file (report sections
  // like /report/l-star) get index.html so the app can route them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barbell-toolkit",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
